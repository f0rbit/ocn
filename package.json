{
	"name": "ocn",
	"version": "0.1.0",
	"description": "Terminal-native session notifications for OpenCode",
	"type": "module",
	"main": "src/plugin.ts",
	"exports": {
		".": "./src/plugin.ts",
		"./config": "./src/config.ts",
		"./state": "./src/state.ts",
		"./tmux-status": "./src/tmux-status.ts"
	},
	"bin": {
		"ocn-tmux-status": "scripts/ocn-tmux-status",
		"ocn-status": "scripts/ocn-status"
	},
	"files": ["src", "scripts", "README.md"],
	"keywords": ["opencode", "notifications", "tmux"],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/f0rbit/ocn.git"
	},
	"scripts": {
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit",
		"lint": "bunx biome check .",
		"lint:fix": "bunx biome check --write .",
		"doctor": "bun src/doctor.ts",
		"check": "bun run lint && bun src/doctor.ts",
		"smoke": "bun src/smoke.ts",
		"gate": "bun run typecheck && bun test && bun run lint && bun run smoke"
	},
	"dependencies": {
		"@opencode/plugin": "2.2.5",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/bun": "latest",
		"typescript": "^5.8.0"
	}
}
